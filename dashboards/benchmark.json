      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT '1 · Generación' AS etapa, (body #>> '{report,seconds,generation}')::double precision AS segundos FROM benchmark_presentations WHERE run_id = ${run:sqlstring} UNION ALL SELECT '2 · Ingesta' AS etapa, (body #>> '{report,seconds,ingestion}')::double precision AS segundos FROM benchmark_presentations WHERE run_id = ${run:sqlstring} UNION ALL SELECT '3 · Arranque Spark' AS etapa, (body #>> '{report,seconds,spark_startup}')::double precision AS segundos FROM benchmark_presentations WHERE run_id = ${run:sqlstring} UNION ALL SELECT '4 · Procesamiento' AS etapa, (body #>> '{report,seconds,processing}')::double precision AS segundos FROM benchmark_presentations WHERE run_id = ${run:sqlstring}",
          "format": "table"
        }
      ],

# Variables de entorno de ejemplo (NUNCA subir secretos reales ni archivos .env)

# Configuración opcional de Azure Blob Storage para Data Lake (LEO-04)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=TU_CUENTA;AccountKey=TU_CLAVE;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER="datalake"

# PostgreSQL
POSTGRES_USER=admin_bd3
POSTGRES_PASSWORD=admin_bd3_pass
POSTGRES_DB=mantenimiento_predictivo
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin_mongo
MONGO_INITDB_ROOT_PASSWORD=admin_mongo_pass
MONGO_PORT=27017

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_grafana
GRAFANA_PORT=3000